# ── The Delegation — example environment ───────────────────────────────────────
# Copy to `.env` and fill in. Only VITE_* vars (or the plain names below, which
# vite.config.ts maps explicitly) reach the browser bundle.

# Optional in local mode: enables the direct Gemini calls inside the browser (BYOK).
# You can also leave it empty and paste the key in the UI (key icon in the header).
GEMINI_API_KEY=

# ── External kanban board transport ────────────────────────────────────────────
# WebSocket URL of the external board bridge. Setting this switches the app to
# REMOTE mode: the local Gemini agent loop (AgentSimulation/AgentBrain) is disarmed
# and the board is driven purely by incoming events.
# Leave empty to keep the local autonomous mode.
VITE_KANBAN_WS_URL=

# Force the mode explicitly: `remote` (never run the local agent loop) or `local`.
# When empty the mode is derived from VITE_KANBAN_WS_URL.
VITE_KANBAN_TRANSPORT_MODE=

# Optional tuning (defaults shown).
VITE_KANBAN_WS_RECONNECT_MIN_MS=500
VITE_KANBAN_WS_RECONNECT_MAX_MS=15000
VITE_KANBAN_WS_HEARTBEAT_MS=15000
VITE_KANBAN_WS_HEARTBEAT_TIMEOUT_MS=10000
VITE_KANBAN_WS_DEDUPE_SIZE=500

# ── kanban-ws-bridge adapter ───────────────────────────────────────────────────
# Explicit `assignee` (Hermes profile name) → `agentIndex` table. Indexes: 0=user,
# 1=lead/orchestrator, 2..4=subagent desks (see src/data/agents.ts). Events whose
# assignee is missing here, or whose index is not in the active team, are dropped and
# NACKed — never guessed from the team order.
# Default when empty: dev:2,qa:3
VITE_KANBAN_AGENT_MAP=

# `auto` (default) translates flat kanban-ws-bridge frames into the §6.2 envelope.
# `off` expects a real §6.2 server on VITE_KANBAN_WS_URL.
VITE_KANBAN_BRIDGE_ADAPTER=

# What the bridge `backlog` frame means: `snapshot` (default) summarizes the replayed
# events into one `board.snapshot`; `ignore` drops it (delta-only stream).
VITE_KANBAN_BACKLOG_MODE=
